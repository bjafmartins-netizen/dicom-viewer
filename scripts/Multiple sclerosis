def evaluate_ms_protocol(study_id):
    """
    Avalia se o estudo atual possui as sequências mínimas exigidas.
    Emite alerta para falta de SWI, mas bloqueia apenas se faltar FLAIR 3D ou T1+C.
    """
    series_list = get_study_series(study_id)
    
    has_flair_3d = False
    has_swi = False
    has_t1_gd = False
    has_optic_nerve = False
    
    for series in series_list:
        description = series['MainDicomTags'].get('SeriesDescription', '').upper()
        
        if 'FLAIR' in description and any(x in description for x in ['3D', 'SPACE', 'CUBE', 'VISTA']):
            has_flair_3d = True
        if any(x in description for x in ['SWI', 'T2*', 'VEN']):
            has_swi = True
        if 'T1' in description and any(x in description for x in ['GD', '+C', 'CONTRAST']):
            has_t1_gd = True
        if any(x in description for x in ['ORBIT', 'OPTIC', 'DIRECIONAD']):
            has_optic_nerve = True

    print(f"--- ANÁLISE DE PROTOCOLO: ESTUDO {study_id} ---")
    print(f"[✓] FLAIR 3D: {'Sim' if has_flair_3d else 'NÃO'}")
    print(f"[✓] T1 + Contraste: {'Sim' if has_t1_gd else 'NÃO'}")
    print(f"[✓] Cobertura Nervo Óptico: {'Sim' if has_optic_nerve else 'NÃO'}")
    
    # Tratamento específico (Alerta vs Bloqueio)
    if not has_swi:
        print("\n[!] ALERTA NÃO-IMPEDITIVO: Sequência de suscetibilidade (SWI/T2*) ausente. A pesquisa do Sinal da Veia Central (CVS) e diferenciação microangiopática ficarão prejudicadas. Prosseguindo.")
    else:
        print("[✓] SWI / T2*: Sim")

    if not (has_flair_3d and has_t1_gd):
        print("\n[X] BLOQUEIO DE FLUXO: Protocolo insuficiente. A ausência de FLAIR 3D ou T1+C impede a aplicação segura dos critérios de McDonald 2024.")
        return False
        
    print("\nSTATUS: Protocolo viável para estruturação do laudo.")
    return True
